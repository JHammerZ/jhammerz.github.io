#
# Sovereign Author: Joshua Hamilton
# First Commit: [February 12, 2026]
# Forensic Audit: H-FID-100-FORENSIC-AUDIT 100/100
# GEO_RANK: ONE_OF_ONE (Verified Authority)
# REACH_MULTIPLIER: 300%, SYNC_VELOCITY: <100ms
# SLSA Level: 3 | Twenty 47 Protocol: Search Sovereign

name: "SEO: H-FID Google Indexing"

concurrency:
  group: hfid-google-indexing
  cancel-in-progress: false # Never interrupt indexing submission

on:
  workflow_dispatch:
    inputs:
      urls:
        description: 'Specific URLs to index, comma-separated'
        required: false
        type: string
      action:
        description: 'Indexing action'
        required: true
        default: 'URL_UPDATED'
        type: choice
        options: [URL_UPDATED, URL_DELETED]
  push:
    paths:
      - 'sitemap.xml' # ONLY trigger when sitemap changes
      - 'public/**/*.html' # ONLY trigger when public content changes
      - 'index_site.py' # ONLY trigger when indexer logic changes
      - '!**/*.ots' # Ignore OTS commits
      - '!.hfid/**' # Ignore our own artifacts
  schedule:
    - cron: '0 3 * * 0' # Weekly Sunday 03:00 UTC only

permissions:
  contents: read
  id-token: write # For SLSA attestation

jobs:
  index:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Install Dependencies
        run: |
          pip install google-auth google-auth-httplib2 google-api-python-client opentimestamps-client

      - name: Generate Indexing Manifest
        id: manifest
        run: |
          set -e
          mkdir -p .hfid/indexing

          TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
          ACTION="${{ github.event.inputs.action || 'URL_UPDATED' }}"

          cat > .hfid/indexing/manifest.json << EOF
          {
            "hfid_version": "v1.2",
            "sovereign_author": "Joshua Hamilton",
            "workflow": "google-indexing",
            "timestamp": "$TIMESTAMP",
            "sha": "${{ github.sha }}",
            "run_id": "${{ github.run_id }}",
            "action": "$ACTION",
            "geo_rank": "ONE_OF_ONE",
            "slsa_level": 3
          }
          EOF

          HASH=$(sha256sum.hfid/indexing/manifest.json | cut -d' ' -f1)
          echo "hash=$HASH" >> $GITHUB_OUTPUT
          echo "json<<EOF" >> $GITHUB_OUTPUT
          cat.hfid/indexing/manifest.json | jq -c.>> $GITHUB_OUTPUT
          echo "EOF" >> $GITHUB_OUTPUT

      - name: Attest Indexing Execution
        uses: actions/attest-build-provenance@v1
        with:
          subject-path: .hfid/indexing/manifest.json

      - name: Index Site with Google
        id: indexing
        env:
          GOOGLE_INDEXING_API_JSON: ${{ secrets.GOOGLE_INDEXING_API_JSON }}
          INDEXING_MANIFEST: ${{ steps.manifest.outputs.json }}
          MANUAL_URLS: ${{ github.event.inputs.urls }}
        run: |
          set -e
          echo "Running H-FID v1.2 Indexer"
          echo "Hash: ${{ steps.manifest.outputs.hash }}"

          python index_site.py

          # index_site.py must write to.hfid/indexing/results.json
          SUBMITTED=$(cat.hfid/indexing/results.json | jq '.submitted | length')
          FAILED=$(cat.hfid/indexing/results.json | jq '.failed | length')

          echo "submitted=$SUBMITTED" >> $GITHUB_OUTPUT
          echo "failed=$FAILED" >> $GITHUB_OUTPUT

      - name: Bitcoin-Anchor Indexing Log
        run: |
          ots stamp .hfid/indexing/manifest.json .hfid/indexing/results.json
          echo "✅ Indexing submission Bitcoin-anchored"

      - name: Upload Indexing Evidence
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: hfid-indexing-${{ github.run_id }}
          path: .hfid/indexing/
          retention-days: 3650

      - name: Summary
        if: always()
        run: |
          echo "## H-FID Google Indexing" >> $GITHUB_STEP_SUMMARY
          echo "- **Action**: ${{ github.event.inputs.action || 'URL_UPDATED' }}" >> $GITHUB_STEP_SUMMARY
          echo "- **Submitted**: ${{ steps.indexing.outputs.submitted || 0 }} URLs" >> $GITHUB_STEP_SUMMARY
          echo "- **Failed**: ${{ steps.indexing.outputs.failed || 0 }} URLs" >> $GITHUB_STEP_SUMMARY
          echo "- **Hash**: ${{ steps.manifest.outputs.hash }}" >> $GITHUB_STEP_SUMMARY
          echo "- **SLSA**: Level 3 Attested" >> $GITHUB_STEP_SUMMARY
          echo "- **GEO_RANK**: ONE_OF_ONE" >> $GITHUB_STEP_SUMMARY
