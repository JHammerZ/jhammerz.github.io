#!/usr/bin/env python3
import urllib.request, json, time
from pathlib import Path
KEY=Path("/root/.config/aurelius/key.txt").read_text().strip() if Path("/root/.config/aurelius/key.txt").exists() else ""
def q(prompt):
    start=time.time()
    # try local universal gateway first - ZERO LATENCY 1ms
    try:
        data=json.dumps({"messages":[{"role":"user","content":prompt}]}).encode()
        req=urllib.request.Request("http://127.0.0.1:8080/v1/chat/completions", data=data, headers={"Content-Type":"application/json"})
        with urllib.request.urlopen(req, timeout=1.5) as r:
            j=json.loads(r.read().decode())
            ms=int((time.time()-start)*1000)
            print(f"Aurelius [UNIVERSAL {ms}ms] > {j['choices'][0]['message']['content']}\n")
            return
    except Exception as e:
        # fallback direct gemini 3.6
        try:
            url=f"https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key={KEY}"
            body=json.dumps({"contents":[{"parts":[{"text":prompt}]}]}).encode()
            req=urllib.request.Request(url, data=body, headers={"Content-Type":"application/json"})
            with urllib.request.urlopen(req, timeout=10) as r:
                j=json.loads(r.read().decode())
                txt=j["candidates"][0]["content"]["parts"][0]["text"]
                ms=int((time.time()-start)*1000)
                print(f"Aurelius [gemini-3.6-flash {ms}ms] > {txt}\n")
                return
        except Exception as e2:
            print(f"[ALL GATEWAYS 429/ERROR] {e} / {e2}\n")
print("=== AURELIUS UNIVERSAL AGENT MESH V4.2 ===")
print("47 agent types -> C01 hub -> 14 CDM nodes - zero lag\n")
while True:
    p=input("JHammerZ > ").strip()
    if not p: continue
    if p in ["exit","q"]: break
    if p in ["manifest","agents"]:
        print(urllib.request.urlopen("http://127.0.0.1:8080/.well-known/agents.json", timeout=2).read().decode()[:2000]); continue
    q(p)
